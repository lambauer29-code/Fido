{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte für das FinDocu-Hauptfenster",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "mailto:*" }, { "url": "tel:*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$TEMP/findocu/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$TEMP/findocu/**" }, { "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DESKTOP/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$TEMP/findocu" }, { "path": "$TEMP/findocu/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://fido-five.vercel.app/*" }, { "url": "https://*.vercel.app/*" }]
    }
  ]
}
